// Prisma 7 : client genere dans src/generated/prisma (non versionne,
// `npm install` le regenere) ; l'URL de la base est dans prisma.config.ts et,
// a l'execution, passee a l'adaptateur libSQL (src/lib/db.ts).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  isAdmin             Boolean              @default(false)
  // 50 Go decimaux : coherent avec l'affichage "x Go / 50 Go" (base 1000).
  quotaBytes          BigInt               @default(50000000000)
  usedBytes           BigInt               @default(0)
  // Secret TOTP chiffre (AES-256-GCM, cf. src/lib/totp-crypto.ts).
  totpSecret          String?
  // Secret en cours d'enrolement (chiffre), confirme par un premier code.
  totpPendingSecret   String?
  // Dernier pas TOTP accepte : un code deja utilise est refuse (anti-rejeu).
  totpLastCounter     Int?
  // Codes de recuperation : JSON d'empreintes SHA-256 (usage unique).
  totpRecoveryCodes   String?
  createdAt           DateTime             @default(now())
  nodes               Node[]
  loginLogs           LoginLog[]
  sessions            Session[]
  twoFactorChallenges TwoFactorChallenge[]
}

model Node {
  id         String   @id @default(cuid())
  ownerId    String
  parentId   String?
  type       String // "FILE" | "FOLDER"
  name       String
  size       BigInt   @default(0)
  mimeType   String?
  storageKey String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner    User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parent   Node?  @relation("Tree", fields: [parentId], references: [id], onDelete: Cascade)
  children Node[] @relation("Tree")

  // NB : en SQLite les NULL sont distincts dans un index UNIQUE -> cette
  // contrainte ne couvre pas la racine (parentId NULL). Un index unique
  // partiel "Node_ownerId_root_name_key" (ownerId, name) WHERE parentId IS
  // NULL est cree a la main dans la migration unique_root_names.
  @@unique([ownerId, parentId, name])
  @@index([ownerId, parentId])
  @@index([ownerId, name])
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// Session cote serveur : le cookie (chiffre) ne contient que l'identifiant
// aleatoire ; on n'en stocke que le hash SHA-256. Supprimer la ligne revoque
// immediatement la session (deconnexion, changement de mot de passe...).
model Session {
  id         String   @id // sha256(identifiant du cookie), hex
  userId     String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime // duree de vie absolue

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Etape 2FA de la connexion : creee apres un mot de passe valide, le cookie
// (chiffre) n'en porte que l'identifiant. Le client n'a plus a renvoyer le
// mot de passe avec le code ; nombre d'essais et duree de vie bornes.
model TwoFactorChallenge {
  id        String   @id // sha256(identifiant du cookie), hex
  userId    String
  ip        String
  attempts  Int      @default(0)
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
