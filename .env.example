DATABASE_URL="file:./dev.db"
# Genere un secret avec: openssl rand -hex 32
SESSION_SECRET="change-me-64-hex-chars"
STORAGE_DIR="./storage"
# Taille max d un fichier uploade (4 Go par defaut)
MAX_UPLOAD_SIZE_BYTES="4294967296"
# Mettre a "true" uniquement si l app est servie derriere du HTTPS/TLS
# (active cookie secure + upgrade-insecure-requests). En HTTP simple: false
APP_HTTPS="false"
# "true" UNIQUEMENT si l app est derriere un reverse-proxy de confiance qui
# ajoute l IP du client a X-Forwarded-For (nginx: proxy_add_x_forwarded_for).
# Sinon (acces direct) laisser "false" : l IP de la socket est utilisee.
TRUST_PROXY="false"
# Cle de chiffrement des secrets 2FA (>= 32 caracteres, openssl rand -hex 32).
# Optionnelle : a defaut, derivee de SESSION_SECRET.
TOTP_ENCRYPTION_KEY=""
