{
  "name": "web-storage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node server.mjs --dev",
    "build": "next build",
    "start": "NODE_ENV=production node server.mjs",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "set-password": "tsx scripts/set-password.ts",
    "find-truncated": "tsx scripts/find-truncated-uploads.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "encrypt-totp": "tsx scripts/encrypt-totp-secrets.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-libsql": "7.10.0",
    "@prisma/client": "7.10.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "18.0.4",
    "iron-session": "^8.0.4",
    "next": "16.3.8",
    "prisma": "7.10.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^6.0.4",
    "@types/node": "^22",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.0.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4"
  }
}
